# SupervisedAutoML Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_ENV=development
APP_DEBUG=true
APP_PORT=8501

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Data paths (optional overrides)
# DATA_DIR=./data
# ARTIFACTS_DIR=./artifacts
# LOGS_DIR=./logs
